[preset00]
fDecay=0.975000
fGammaAdj=1.800000
fWaveAlpha=0.000000
zoom=1.000000
warp=0.300000
wavecode_0_enabled=1
wavecode_0_samples=256
wavecode_0_bSpectrum=1
wavecode_0_bDrawThick=1
wavecode_0_bAdditive=1
wavecode_0_scaling=1.000000
wavecode_0_smoothing=0.600000
wave_0_per_point1=x = sample;
wave_0_per_point2=y = 0.08 + min(0.25, value1*0.3);
