[preset00]
fDecay=0.970000
fGammaAdj=1.800000
nWaveMode=5
bAdditiveWaves=1
bDarkenCenter=1
bMaximizeWaveColor=1
fWaveAlpha=0.800000
fWaveScale=1.000000
fWaveSmoothing=0.600000
zoom=1.040000
warp=0.200000
per_frame_1=zoom = 1.04 + 0.04*min(2, bass_att);
per_frame_2=rot = 0.02*sin(time*0.5);
per_frame_3=wave_r = 0.5 + 0.5*sin(time*0.9);
per_frame_4=wave_g = 0.5 + 0.5*sin(time*1.3 + 2);
per_frame_5=wave_b = 0.6 + 0.4*treb_att*0.5;
per_pixel_1=rot = rot + 0.05*(1 - rad);
per_pixel_2=zoom = zoom + 0.02*sin(ang*6 + time);
